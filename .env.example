# Supabase (public anon key only — never put the service_role key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile (free CAPTCHA) — site key is public; the secret key lives in Supabase Edge Function secrets
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: canonical site URL used for product links in WhatsApp messages and sitemap
# e.g. https://chaitusnaturals.pages.dev
NEXT_PUBLIC_SITE_URL=https://chaitusnaturals.pages.dev
# WhatsApp ordering number (international format without +)
NEXT_PUBLIC_WHATSAPP_NUMBER=917396457733
